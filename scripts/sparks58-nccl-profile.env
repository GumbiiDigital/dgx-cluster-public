# Tuned NCCL/OpenMPI profile for DGX Spark nodes 5-8 on CRS804.
#
# Source this file locally before running scripts/run-sparks58-nccl-profile.sh,
# or pass PROFILE_FILE=scripts/sparks58-nccl-profile.env to the harness.

UCX_NET_DEVICES=enp1s0f1np1,enP2p1s0f1np1
NCCL_SOCKET_IFNAME=enp1s0f1np1,enP2p1s0f1np1
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_NET_GDR_LEVEL=2

NCCL_IB_QPS_PER_CONNECTION=4
NCCL_IB_SPLIT_DATA_ON_QPS=1
NCCL_MIN_NCHANNELS=8
NCCL_MAX_NCHANNELS=8
NCCL_IGNORE_CPU_AFFINITY=1
