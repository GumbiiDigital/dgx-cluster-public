# Sparks 1-4 CRS804 dual-rail NCCL profile.
#
# Source through PROFILE_FILE with scripts/run-sparks58-nccl-profile.sh, or use
# the sparks14 wrapper scripts. This file is host-side only and does not touch
# CRS804 state.

GROUP_LABEL="Sparks 1-4"
POLICY_PREFIX="sparks14"
CONFIG_LABEL="sparks14-qps4split1-ch8"
APPLY_TUNED_DEFAULTS="0"

LAUNCHER="192.0.2.10"
MPI_KEY="/opt/public-user/.ssh/id_ed25519"
MPI_HOSTS="192.0.2.10:1,192.0.2.10:1,192.0.2.10:1,192.0.2.10:1"
HOSTS="192.0.2.10 192.0.2.10 192.0.2.10 192.0.2.10"
SYNC_HOSTS="192.0.2.10 192.0.2.10 192.0.2.10"
PEERS="192.0.2.10 192.0.2.10 192.0.2.10"
PEER_LABEL="Sparks 2-4"

UCX_NET_DEVICES="enp1s0f1np1,enP2p1s0f1np1"
NCCL_SOCKET_IFNAME="enp1s0f1np1,enP2p1s0f1np1"
NCCL_IB_HCA="rocep1s0f1,roceP2p1s0f1"
NCCL_IB_DISABLE="0"
NCCL_NET_GDR_LEVEL="2"
NCCL_IB_QPS_PER_CONNECTION="4"
NCCL_IB_SPLIT_DATA_ON_QPS="1"
NCCL_MIN_NCHANNELS="8"
NCCL_MAX_NCHANNELS="8"

REMOTE_BUILD_DIR="/opt/public-cluster/src/sparks14-tuner-channels"
REMOTE_TUNER_PLUGIN="/opt/public-cluster/src/sparks14-tuner-channels/libnccl-tuner-sparks58-channels.so"
