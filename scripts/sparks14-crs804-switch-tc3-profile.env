# Sparks 1-4 CRS804 switch-classified NCCL profile.
#
# This extends the frozen host-side profile with the traffic-class marking used
# by the 2026-07-01 CRS804 switch QoS campaign. It assumes the CRS804 candidate
# profile documented in docs/crs804-sparks-1-4-switch-qos-campaign-2026-07-01.md.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/sparks14-nccl-profile.env"

CONFIG_LABEL="sparks14-switch-tc104-strict"
NCCL_IB_TC="104"
